{
    "enhConfig": {
        "enhKey": "🤝",
        "spawn": "be-committed/be-committed.js",
        "withAttrs": {
            "base": "🤝",
            "to": "${base}-to",
            "nudge": "${base}-nudge",
            "_nudge": {
                "instanceOf": "Boolean"
            }
        }
    },
    "customData": {
        "actions": {
            "hydrate": {
                "ifAllOf": [
                    "on",
                    "enhancedElement"
                ]
            },
            "nudgeEnhancedElement": {
                "ifAllOf": [
                    "nudge",
                    "enhancedElement"
                ]
            },
            "weakenTo": {
                "ifAllOf": [
                    "to"
                ]
            }
        },
        "compacts": {
            "when_resolved_changes_dispatch": "resolved"
        },
        "weakRef": {
            "properties": [
                "enhancedElement"
            ]
        },
        "defaultPropVals": {
            "on": "keydown"
        }
    }
}
